# Overlay de entorno para builds NativePHP (escritorio y móvil).
# El build nativo copia este fichero a .env antes de empaquetar: viaja DENTRO
# del bundle, así que aquí JAMÁS van secretos (Stripe, SMTP real, claves).
# Los values sensibles los pide la app por UI o los guarda el usuario en su BD local.

APP_NAME=TornadoCMS
APP_ENV=production
APP_DEBUG=false
# La línea vacía es necesaria: native:prepare-env / key:generate la rellenan
# una sola vez (APP_KEY estable entre builds).
APP_KEY=

# La app nativa se sirve a sí misma dentro del webview (mismo origen = cookies Sanctum).
APP_URL=http://localhost
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# BD embebida sqlite: WAL + busy_timeout para la concurrencia del webview.
DB_CONNECTION=sqlite
DB_SQLITE_JOURNAL_MODE=WAL
DB_SQLITE_BUSY_TIMEOUT=5000

# Sin Redis en el binario: drivers locales.
CACHE_STORE=file
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

# Disco público: la raíz la fija el build a un directorio escribible del SO
# (ver config/nativephp.php y docs). URL relativa: Laravel sirve /storage same-origin.
FILESYSTEM_DISK=public
FILESYSTEM_PUBLIC_URL=/storage

# Nunca pagos Stripe desde el binario: el checkout ocurre en el API central.
TCMS_PAYMENT_GATEWAY=manual

# F6 (móvil) sobreescribe este valor con native-mobile.
TCMS_RUNTIME=native-desktop

MAIL_MAILER=log
LOG_CHANNEL=stack
LOG_LEVEL=info
