# Overlay de entorno para el build NativePHP MÓVIL (iOS/Android).
# Mismo contrato que .env.native: viaja dentro del bundle, sin secretos.
#
# IMPORTANTE: nativephp/desktop y nativephp/mobile son mutuamente excluyentes
# (conflicto declarado en composer). El build móvil se hace desde un checkout
# donde nativephp/mobile sustituye a nativephp/desktop:
#   composer remove nativephp/desktop && composer require nativephp/mobile
# (o un checkout/rama dedicada). Ver docs del repo.

APP_NAME=TornadoCMS
APP_ENV=production
APP_DEBUG=false
# Igual que .env.native: la línea la rellena native:prepare-env la primera vez.
APP_KEY=

APP_URL=http://localhost
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

DB_CONNECTION=sqlite
DB_SQLITE_JOURNAL_MODE=WAL
DB_SQLITE_BUSY_TIMEOUT=5000

CACHE_STORE=file
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=public
FILESYSTEM_PUBLIC_URL=/storage

TCMS_PAYMENT_GATEWAY=manual

# Diferencia clave con .env.native: runtime móvil.
TCMS_RUNTIME=native-mobile

MAIL_MAILER=log
LOG_CHANNEL=stack
LOG_LEVEL=info
